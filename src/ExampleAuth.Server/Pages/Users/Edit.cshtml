@page "{id:guid}"
@model ExampleAuth.Server.Pages.Users.EditModel
@{
    ViewData["Title"] = "Editar usuário";
    Layout = "/Pages/Shared/_AdminLayout.cshtml";
}
<h1>Editar @Model.Email</h1>
<div class="card">
    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <p class="error">@Model.ErrorMessage</p>
        }
        <label class="label" asp-for="DisplayName">Nome</label>
        <input class="input" asp-for="DisplayName" autofocus />

        @if (User.IsInRole("Administrator"))
        {
            var isSelf = Model.Id == Model.CurrentUserId;

            <label class="label" asp-for="SelectedRole">Role</label>
            <select class="input" asp-for="SelectedRole" disabled="@isSelf">
                <option value="None">Usuário</option>
                <option value="Support">Suporte</option>
                <option value="Administrator">Administrador</option>
            </select>
            @if (isSelf)
            {
                <p class="hint">Você não pode alterar a própria role.</p>
            }

            <label class="flex items-center gap-2 text-sm text-ink-secondary" asp-for="IsDisabled">
                <input class="size-4 accent-brand-orange" type="checkbox" asp-for="IsDisabled" disabled="@isSelf" />
                Conta desabilitada (bloqueia login, SSO e renovação de token)
            </label>
            @if (isSelf)
            {
                <p class="mb-4 text-xs text-ink-tertiary">Você não pode habilitar/desabilitar a própria conta.</p>
            }
        }

        <button class="btn btn-primary mt-4" type="submit">Salvar</button>
    </form>
</div>
