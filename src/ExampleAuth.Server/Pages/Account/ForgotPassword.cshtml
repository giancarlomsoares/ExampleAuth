@page
@model ExampleAuth.Server.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Esqueci minha senha";
    Layout = "/Pages/Shared/_AuthLayout.cshtml";
}
@if (Model.Submitted)
{
    <div class="mb-6 flex justify-center">
        <partial name="_Icon" model="@("check-circle")" />
    </div>
    <h1 class="mb-4 text-center text-xl font-bold tracking-tight text-ink-primary">Verifique seu email</h1>
    <p class="mb-6 text-center text-sm text-ink-secondary">Se o email informado existir em nossa base, enviamos um link para redefinição de senha. O link expira em 1 hora.</p>
    <p class="text-center text-sm">
        <a class="text-brand-blue-bright hover:underline" href="/Account/Login">Voltar para o login</a>
    </p>
}
else
{
    <div class="mb-6 flex justify-center">
        <partial name="_Icon" model="@("envelope")" />
    </div>
    <h1 class="mb-6 text-center text-xl font-bold tracking-tight text-ink-primary">Esqueci minha senha</h1>
    <form method="post">
        @Html.AntiForgeryToken()
        <label class="label" for="Email">E-mail</label>
        <input class="input" type="email" id="Email" name="Email" required autofocus />
        <button class="btn btn-primary w-full justify-center" type="submit">Enviar link de redefinição</button>
        <p class="mt-4 text-center text-sm">
            <a class="text-brand-blue-bright hover:underline" href="/Account/Login">Voltar para o login</a>
        </p>
    </form>
}
