@page
@model ExampleAuth.Server.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Redefinir senha";
    Layout = "/Pages/Shared/_AuthLayout.cshtml";
}
@if (Model.InvalidLink)
{
    <div class="mb-6 flex justify-center">
        <partial name="_Icon" model="@("x-circle")" />
    </div>
    <h1 class="mb-4 text-center text-xl font-bold tracking-tight text-ink-primary">Link inválido</h1>
    <p class="mb-6 text-center text-sm text-ink-secondary">Este link de redefinição é inválido ou expirou. Solicite um novo.</p>
    <p class="text-center text-sm">
        <a class="text-brand-blue-bright hover:underline" href="/Account/ForgotPassword">Solicitar novo link</a>
    </p>
}
else if (Model.Succeeded)
{
    <div class="mb-6 flex justify-center">
        <partial name="_Icon" model="@("check-circle")" />
    </div>
    <h1 class="mb-4 text-center text-xl font-bold tracking-tight text-ink-primary">Senha redefinida</h1>
    <p class="mb-6 text-center text-sm text-ink-secondary">Sua senha foi redefinida com sucesso.</p>
    <p class="text-center text-sm">
        <a class="text-brand-blue-bright hover:underline" href="/Account/Login">Ir para o login</a>
    </p>
}
else
{
    <div class="mb-6 flex justify-center">
        <partial name="_Icon" model="@("key")" />
    </div>
    <h1 class="mb-6 text-center text-xl font-bold tracking-tight text-ink-primary">Redefinir senha</h1>
    <form method="post">
        @Html.AntiForgeryToken()
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <p class="error">@Model.ErrorMessage</p>
        }
        <input type="hidden" name="UserId" value="@Model.UserId" />
        <input type="hidden" name="Code" value="@Model.Code" />
        <label class="label" for="NewPassword">Nova senha</label>
        <input class="input" type="password" id="NewPassword" name="NewPassword" required autofocus />
        <label class="label" for="ConfirmPassword">Confirmar nova senha</label>
        <input class="input" type="password" id="ConfirmPassword" name="ConfirmPassword" required />
        <button class="btn btn-primary w-full justify-center" type="submit">Redefinir senha</button>
    </form>
}
