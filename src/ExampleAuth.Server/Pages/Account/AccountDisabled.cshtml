@page
@{
    ViewData["Title"] = "Conta desabilitada";
    Layout = "/Pages/Shared/_AuthLayout.cshtml";
}
<div class="mb-6 flex justify-center">
    <partial name="_Icon" model="@("alert-triangle")" />
</div>
<h1 class="mb-4 text-center text-xl font-bold tracking-tight text-ink-primary">Conta desabilitada</h1>
<p class="mb-6 text-center text-sm text-ink-secondary">Sua conta foi desabilitada por um administrador. Fale com um administrador para mais informações.</p>
<p class="text-center text-sm">
    <a class="text-brand-blue-bright hover:underline" href="/connect/logout">Sair</a>
</p>
