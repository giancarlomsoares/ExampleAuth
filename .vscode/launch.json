{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ExampleAuth.Server (https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ExampleAuth.Server/bin/Debug/net10.0/ExampleAuth.Server.dll",
      "cwd": "${workspaceFolder}/src/ExampleAuth.Server",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7061;http://localhost:5213"
      },
      "serverReadyAction": {
        "pattern": "\\bNow listening on:\\s+(https://\\S+)",
        "action": "openExternally"
      }
    }
  ]
}
